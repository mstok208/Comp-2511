    <!-- 1. TECHNICAL CONFIGURATION                 -->
    <!-- ========================================== -->
    
    <!-- Sets the character encoding for the document (UTF-8 supports almost all languages) -->
    <meta charset="UTF-8">
    
    <!-- Ensures proper rendering and touch zooming on mobile devices -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- ========================================== -->
    <!-- 2. SEARCH ENGINE OPTIMIZATION (SEO)       -->
    <!-- ========================================== -->
    
    <!-- The title displayed on the browser tab and in search engine results -->
    <title>HTML5 Boilerplate Template</title>
    
    <!-- A short summary of the page content used by search engines on results pages -->
    <meta name="description" content="A clean, structured HTML5 boilerplate template featuring organized meta tags and semantic structural elements.">
    
    <!-- Keywords relevant to the page content (less critical for modern SEO, but standard) -->
    <meta name="keywords" content="HTML5, boilerplate, template, semantic HTML, web development">
    
    <!-- Instructs search engine bots to index the page and follow links within it -->
    <meta name="robots" content="index, follow">

